    "docs.architecture.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every project is a separate feature module built with Clean Architecture:\n\n• Domain — entities and repository protocols\n• Data — repository implementations and local storage\n• Presentation — MVVM: view models and UIKit views\n\nThe whole UI is built in code, without storyboards."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый проект — отдельный модуль на основе Clean Architecture:\n\n• Domain — сущности и протоколы репозиториев\n• Data — реализации репозиториев и локальное хранилище\n• Presentation — MVVM: view model и UIKit-представления\n\nВесь интерфейс создан в коде, без storyboard."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir loyiha Clean Architecture asosidagi alohida modul:\n\n• Domain — entity va repository protokollari\n• Data — repository realizatsiyalari va mahalliy xotira\n• Presentation — MVVM: view model va UIKit view'lar\n\nButun interfeys storyboard'siz, kod orqali yaratilgan."
          }
        }
      }
    },
    "docs.architecture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architecture"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архитектура"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxitektura"
          }
        }
      }
    },
    "docs.localization.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app supports Uzbek, Russian and English, and system, light or dark appearance.\n\nBoth can be changed at any time in Settings — no restart needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение поддерживает узбекский, русский и английский языки, а также системную, светлую и тёмную темы.\n\nИх можно изменить в любой момент в Настройках — перезапуск не нужен."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova oʻzbek, rus va ingliz tillarini hamda tizim, yorugʻ va qorongʻi mavzularni qoʻllab-quvvatlaydi.\n\nIkkalasini ham istalgan vaqtda Sozlamalarda oʻzgartirish mumkin — qayta ishga tushirish shart emas."
          }
        }
      }
    },
    "docs.localization.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Languages & themes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языки и темы"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillar va mavzular"
          }
        }
      }
    },
    "docs.release.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects move through three stages: Research → Planned → In progress.\n\nWhen a project is ready, it moves from the Future tab to Home and becomes available to everyone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты проходят три этапа: Исследование → Запланировано → В работе.\n\nКогда проект готов, он переходит из вкладки «Будущее» на «Главную» и становится доступен всем."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Loyihalar uch bosqichdan oʻtadi: Tadqiqot → Rejada → Jarayonda.\n\nLoyiha tayyor boʻlgach, u «Kelajak» boʻlimidan «Asosiy» boʻlimiga koʻchadi va hamma uchun ochiladi."
          }
        }
      }
    },
    "docs.release.title": {
