    "future.flashcards.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn words and terms with spaced repetition that shows each card right before you forget it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учите слова и термины с интервальным повторением: карточка появляется прямо перед тем, как вы её забудете."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soʻz va atamalarni oraliqli takrorlash usulida oʻrganing: har bir kartochka unutishingizdan oldin koʻrsatiladi."
          }
        }
      }
    },
